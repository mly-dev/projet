# Requis — génération des posts par Claude
ANTHROPIC_API_KEY=

# GitHub — source des commits
# Token optionnel pour les dépôts publics ; requis pour les dépôts privés
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Notion — source optionnelle des tâches terminées
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_STATUS_PROPERTY=Status
NOTION_DONE_VALUE=Done

# Stripe — optionnel : ajoute le MRR au storytelling + un graphique de revenus
STRIPE_SECRET_KEY=

# Linear — optionnel : issues terminées dans le storytelling
LINEAR_API_KEY=

# Plausible — optionnel : trafic du site dans le storytelling
# PLAUSIBLE_API_URL pour une instance self-hosted (défaut : plausible.io)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_URL=

# LinkedIn — requis uniquement pour publier sur LinkedIn
# Token OAuth avec les scopes openid + w_member_social.
# LINKEDIN_AUTHOR_URN (urn:li:person:xxx) est déduit du token si absent.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X (Twitter) — requis uniquement pour `bip publish`
# Créez une app sur developer.x.com avec l'accès "Read and write",
# puis générez les 4 clés ci-dessous (OAuth 1.0a user context).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
