# Kayna Kayna Pay — configuration de la plateforme

# Base de données PostgreSQL
DATABASE_URL=postgres://kkp:kkp@localhost:5432/kaynakaynapay

# Secret des jetons (OBLIGATOIRE à changer en production)
JWT_SECRET=changez-moi-en-production
JWT_DUREE=24h

# Port HTTP
PORT=3000

# Passerelle SMS : "console" en développement (le code OTP s'affiche dans les
# journaux du serveur). La passerelle locale réelle s'ajoutera dans lib/sms/.
SMS_FOURNISSEUR=console

# Dossier des photos de produits. Facultatif : par défaut, un dossier
# « medias/ » créé à côté de ce fichier.
#
# Renseignez un chemin ABSOLU si les photos s'envoient sans s'afficher
# ensuite (404 sur /api/medias/...) : cela retire toute ambiguïté sur le
# dossier de travail du serveur. Sous Windows, doublez les barres obliques
# inverses ou utilisez des barres normales.
#   MEDIAS_DIR=C:/Users/PC/projet/kayna-kayna-pay/plateforme/medias
#
# En production, placez-le hors de l'application, sur un volume sauvegardé.
# MEDIAS_DIR=


# ─────────────────────────────────────────────────────────────────────────────
# Mise en ligne uniquement — sans effet sur un poste de développement.
# Détail et génération du secret :  npm run preparer
# ─────────────────────────────────────────────────────────────────────────────

# Active le mode production : cookies « Secure », contrôles de configuration
# bloquants, pages précompilées. Défini par l'hébergeur ou par le Dockerfile ;
# ne le mettez pas ici sur votre machine, vous n'auriez plus le rechargement
# automatique.
# NODE_ENV=production

# Nombre de proxys de confiance devant la plateforme. 1 chez un hébergeur.
# À 0 (défaut), la limitation anti-abus voit tout le trafic venir du proxy et
# ne protège plus personne.
# TRUST_PROXY=1

# TLS de la base. Non renseigné, la règle est : vérification active pour une
# base distante, aucun chiffrement en local. Certains hébergeurs (Render,
# Heroku) signent eux-mêmes leur certificat et le refusent à la vérification :
# c'est le seul cas où il faut relâcher le contrôle.
#   DATABASE_SSL=no-verify     accepte un certificat non vérifiable
#   DATABASE_SSL=off           désactive TLS (réseau privé uniquement)
# DATABASE_SSL=

# Mots de passe des comptes de démonstration. Non renseignés, le seed emploie
# les valeurs de démonstration en développement, et en tire au hasard en
# production — affichés une seule fois à la fin du seed.
# SEED_MDP_SUPERADMIN=
# SEED_MDP_ADMIN=
# SEED_MDP_CLIENT=
# SEED_MDP_PARTENAIRE=
